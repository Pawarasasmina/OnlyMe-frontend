# Recipients are resolved from active Main Admin and Moderator accounts in MongoDB.
# Run this on a different machine from your API and website.
MONITOR_WEB_URL=http://localhost:5173
MONITOR_API_READY_URL=http://localhost:3104/api/health/ready
# Generate a random token (at least 32 characters); set the same value on the API.
MONITOR_WATCHDOG_TOKEN=
MONITOR_STATE_FILE=/data/monitor-state.json
# Optional Resend for the separate checker. Supply these on that host too.
RESEND_API_KEY=
EMAIL_FROM=
# Optional existing SMTP mailbox/relay, no email API required.
MONITOR_FROM_EMAIL=
MONITOR_SMTP_HOST=
MONITOR_SMTP_PORT=587
MONITOR_SMTP_SECURE=false
MONITOR_SMTP_USER=
MONITOR_SMTP_PASSWORD=
